{
  "name": "markdown-studio",
  "version": "1.0.0",
  "description": "Browser extension that renders and edits Markdown files in place.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env TARGET=chrome vite build --watch --mode development",
    "build": "node scripts/build-all.mjs",
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:firefox": "cross-env TARGET=firefox vite build",
    "build:safari": "cross-env TARGET=safari vite build && node scripts/build-safari.mjs",
    "zip": "node scripts/zip-targets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "icons": "node scripts/build-icons.mjs",
    "package:chrome": "cross-env TARGET=chrome vite build && node scripts/zip-targets.mjs chrome",
    "firefox:run": "web-ext run --source-dir dist/firefox",
    "clean": "node -e \"import('node:fs/promises').then(f=>f.rm('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.34.0",
    "@hpcc-js/wasm": "^2.36.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-minimap": "^0.5.2",
    "diff": "^9.0.0",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.10.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "plantuml-encoder": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "web-ext": "^8.3.0"
  }
}
